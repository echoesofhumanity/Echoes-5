    "requireAuthorizedIncomingPresenter": true,
    "requireIncomingSessionReady": true,
    "keepCurrentBroadcastUntilIncomingReady": true,
    "fallbackWhenHandoffFails": "24/7-flow",
    "returnToAutomationWhenNoPresenter": true
