  "globalScheduleModel": {
    "version": 1,
    "canonicalTimezone": "UTC",
    "displayInPresenterTimezone": true,
    "displayInListenerTimezone": true,
    "requiredFields": ["id", "programId", "presenterId", "regionId", "startAt", "endAt", "status"],
    "statuses": ["draft", "scheduled", "ready", "on-air", "completed", "cancelled"],
    "assignments": []
  },
  "scheduleConflictPolicy": {
    "version": 1,
    "enabled": true,
    "rejectOverlappingAssignments": true,
    "checkPresenterAvailability": true,
    "checkProgramOverlap": true,
    "checkRegionHandoffWindow": true,
    "allowManualOverride": false,
    "onConflict": "reject",
    "preserveCurrentBroadcast": true
  },
  "scheduleContinuityPolicy": {
    "version": 1,
    "enabled": true,
    "fillUnscheduledGaps": true,
    "gapSource": "24/7-flow",
    "preserveLiveBroadcast": true,
    "preserveReadyHandoff": true,
    "resumeScheduledProgramAfterGap": true,
    "neverAllowSilentGap": true
  },
  "now": null,
  "upNext": null,
