{
  "station": {
    "id": "echoes-radio",
    "name": "Echoes Radio",
    "tagline": "One humanity. One shared frequency.",
    "timezone": "UTC",
    "mode": "scheduled",
    "liveOverride": false
  },
  "streamPolicy": {
    "version": 1,
    "acceptedProtocols": ["https"],
    "acceptedStreamTypes": ["audio/mpeg", "audio/aac", "application/vnd.apple.mpegurl"],
    "requireSecureSource": true,
    "allowEmptySourceWhenOffline": true
  },
  "broadcastContentEditorialPolicy": {
    "version": 1,
    "enabled": true,
    "editorialPrinciples": ["human-dignity", "accuracy", "cultural-respect", "non-exploitation", "public-interest", "editorial-independence"],
    "contentFamilies": ["music", "human-stories", "voices-of-humanity", "conversations", "academy", "poetry-literature", "documentary-radio", "young-voices", "world-windows", "special-broadcasts", "podcasts", "night-echoes"],
    "requiredBeforeBroadcast": ["editorial-status", "rights-status", "content-rating", "language", "source-attribution"],
    "editorialStatuses": ["draft", "review", "approved", "rejected", "withdrawn"],
    "contentRatings": ["general", "guidance", "restricted"],
    "defaultEditorialStatus": "draft",
    "requireApprovalBeforeBroadcast": true,
    "blockRejectedOrWithdrawnContent": true,
    "protectChildrenAndVulnerablePeople": true,
    "prohibitExploitativeTreatment": true,
    "requireContextForSensitiveMaterial": true,
    "requireCorrectionOfMaterialErrors": true,
    "preserveEditorialReviewHistory": true,
    "reviews": []
  },
  "live": {
    "enabled": false,
    "authorized": false,
    "status": "offline",
    "sessionId": null,
    "streamSource": null,
    "streamType": null,
    "presenter": null,
    "programTitle": null,
    "scheduledAt": null,
    "startedAt": null,
    "endedAt": null,
    "takeoverAutomation": true,
    "returnToAutomation": true
  },
  "liveSessionModel": {
    "version": 1,
    "statuses": ["offline", "ready", "on-air", "ending"],
    "requiredForOnAir": ["sessionId", "streamSource", "streamType", "presenter", "programTitle", "startedAt"],
    "transitionOrder": ["offline", "ready", "on-air", "ending", "offline"]
  },
  "presenters": [],
  "presenterModel": {
    "version": 1,
    "requiredFields": ["id", "name", "role", "region", "timezone", "languages", "status"],
    "roles": ["presenter", "producer", "presenter-producer"],
    "statuses": ["active", "inactive"],
    "example": {
      "id": "presenter-example",
      "name": "Example Presenter",
      "role": "presenter",
      "region": "Europe",
      "timezone": "UTC",
      "languages": ["en"],
      "status": "active"
    }
  },
  "presenterAuthorization": {
    "version": 1,
    "defaultLiveAccess": false,
    "requireActivePresenter": true,
    "requireExplicitLivePermission": true,
    "permissions": ["broadcast-live", "prepare-live", "manage-program"],
    "assignments": []
  },
  "presenterAvailabilityModel": {
    "version": 1,
    "canonicalTimezone": "UTC",
    "requiredFields": ["presenterId", "startAt", "endAt", "status"],
    "statuses": ["available", "unavailable", "tentative"],
    "rejectSchedulingWhenUnavailable": true,
    "requireAvailabilityForLiveAssignment": true,
    "windows": []
  },
  "presenterReadinessPolicy": {
    "version": 1,
    "enabled": true,
    "requiredBeforeLive": ["active-presenter", "live-permission", "availability", "valid-stream", "session-ready"],
    "blockLiveWhenNotReady": true,
    "preserveCurrentBroadcastWhenNotReady": true,
    "fallbackWhenScheduledPresenterNotReady": "24/7-flow",
    "checks": []
  },
  "presenterStandbyPolicy": {
    "version": 1,
    "enabled": true,
    "requireActiveStandbyPresenter": true,
    "requireLivePermission": true,
    "requireAvailability": true,
    "requireReadySessionBeforeTakeover": true,
    "activateWhenPrimaryNotReady": true,
    "preserveCurrentBroadcastUntilStandbyReady": true,
    "fallbackWhenNoStandbyReady": "24/7-flow",
    "assignments": []
  },
  "broadcastRecoveryPolicy": {
    "version": 1,
    "enabled": true,
    "detectLiveStreamLoss": true,
    "detectUnexpectedSessionEnd": true,
    "preserveListenerContinuity": true,
    "recoveryOrder": ["standby-presenter", "24/7-flow"],
    "requireStandbyReadyBeforeTakeover": true,
    "fallbackSource": "24/7-flow",
    "allowSilentRecoveryState": false,
    "resumeRecoveredLiveWhenReady": true,
    "events": []
  },
  "recoveryReturnPolicy": {
    "version": 1,
    "enabled": true,
    "requireRecoveredSessionReady": true,
    "requireValidStreamBeforeReturn": true,
    "requireAuthorizedPresenterBeforeReturn": true,
    "returnFromStandbyToPrimary": true,
    "returnFromFallbackToPrimary": true,
    "preserveCurrentAudioUntilPrimaryReady": true,
    "preventAbruptCutover": true,
    "returnMode": "controlled-handoff"
  },
  "broadcastHealthModel": {
    "version": 1,
    "enabled": true,
    "states": ["healthy", "degraded", "recovering", "offline"],
    "signals": ["stream-available", "session-active", "presenter-ready", "schedule-continuity"],
    "healthyRequires": ["stream-available", "schedule-continuity"],
    "degradedTriggersRecovery": true,
    "offlineTriggersFallback": true,
    "fallbackSource": "24/7-flow",
    "preserveListenerContinuity": true,
    "currentState": null,
    "checks": []
  },
  "broadcastIncidentModel": {
    "version": 1,
    "enabled": true,
    "types": ["stream-loss", "session-ended", "presenter-not-ready", "handoff-failed", "schedule-gap", "fallback-activated"],
    "severities": ["info", "warning", "critical"],
    "statuses": ["open", "recovering", "resolved"],
    "requiredFields": ["id", "type", "severity", "status", "startedAt"],
    "recordRecoveryPath": true,
    "recordResolvedAt": true,
    "preserveHistory": true,
    "incidents": []
  },
  "incidentEscalationPolicy": {
    "version": 1,
    "enabled": true,
    "levels": ["observe", "operator-attention", "urgent"],
    "severityMap": {
      "info": "observe",
      "warning": "operator-attention",
      "critical": "urgent"
    },
    "escalateUnresolvedIncidents": true,
    "escalateRepeatedIncidents": true,
    "preserveCurrentBroadcastDuringEscalation": true,
    "fallbackSource": "24/7-flow",
    "requireHumanAcknowledgementForUrgent": true,
    "notifications": []
  },
  "incidentAcknowledgementPolicy": {
    "version": 1,
    "enabled": true,
    "requiredForLevels": ["operator-attention", "urgent"],
    "authorizedRoles": ["producer", "presenter-producer"],
    "requiredFields": ["incidentId", "acknowledgedBy", "acknowledgedAt"],
    "acknowledgementDoesNotResolveIncident": true,
    "requireResolutionEvidence": true,
    "preserveAcknowledgementHistory": true,
    "acknowledgements": []
  },
  "incidentResolutionPolicy": {
    "version": 1,
    "enabled": true,
    "authorizedRoles": ["producer", "presenter-producer"],
    "requiredFields": ["incidentId", "resolvedBy", "resolvedAt", "resolutionType", "evidence"],
    "resolutionTypes": ["primary-restored", "standby-restored", "fallback-stable", "schedule-corrected", "manual-intervention"],
    "requireHealthyBroadcastBeforeResolve": true,
    "requireEvidence": true,
    "closeEscalationOnResolve": true,
    "preserveResolutionHistory": true,
    "resolutions": []
  },
  "postIncidentReviewPolicy": {
    "version": 1,
    "enabled": true,
    "requiredForSeverities": ["warning", "critical"],
    "requiredFields": ["incidentId", "reviewedBy", "reviewedAt", "rootCause", "impact", "correctiveActions"],
    "requireRootCause": true,
    "requireCorrectiveActions": true,
    "trackPreventiveActions": true,
    "preserveReviewHistory": true,
    "reviews": []
  },
  "broadcastRegions": [
    {"id": "africa", "name": "Africa", "referenceTimezone": "Africa/Nairobi"},
